# ==========================================
# VARIÁVEIS DE AMBIENTE DO SISTEMA (PRODUÇÃO)
# ==========================================

# GEMINI_API_KEY: Necessário para geração de resumos executivos e IA nos relatórios de vendas.
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API"

# ==========================================
# SUPABASE (BANCO DE DADOS + AUTENTICAÇÃO)
# ==========================================
# Project URL e chave anônima (públicas, usadas pelo front-end).
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-public"

# Chave service_role: SOMENTE no servidor (Vercel env var / .env.local).
# Nunca deve ser exposta ao navegador nem versionada no git.
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"
